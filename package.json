{
  "name": "wellness-reminder",
  "version": "1.3.0",
  "description": "Background reminders for water, eye breaks, and walks",
  "main": "main.js",
  "author": "Om",
  "private": true,
  "scripts": {
    "start": "electron .",
    "generate-icon": "node scripts/generate-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.omventures.wellnessreminder",
    "productName": "Wellness Reminder",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dashboardPreload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "WellnessReminder-Setup-${version}.${ext}"
    }
  }
}
